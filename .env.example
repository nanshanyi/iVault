# 备份目录（宿主机绝对路径，需提前创建并有写权限）
# 路径按你自己的 NAS 卷结构填，不同平台不一样，常见写法：
#   群晖 / 绿联        /volume1/ivault/backups
#   威联通             /share/CACHEDEV1_DATA/ivault/backups
#   飞牛 / 普通 Linux  /vol1/ivault/backups、/mnt/disk1/ivault/backups
BACKUP_LOCATION=/volume1/ivault/backups
# 元数据目录：SQLite 数据库 + lockdown 配对证书（务必持久化）
META_LOCATION=/volume1/ivault/data
# Web 访问端口
IVAULT_PORT=8666

# 界面左下角显示的系统名，可留空（留空则尝试读取宿主机 os-release，取不到就隐藏）
# 例：DSM 7.2 / UGOS 1.21 / QTS 5.1 / TrueNAS SCALE 24.04 / fnOS 0.8
IVAULT_OS_NAME=

# 无线（Wi-Fi）通道：1=启用 netmuxd（默认），0=纯 USB。
# 默认 compose 走 host 网络，无线开箱可用（还需 iOS 侧开启「通过 Wi-Fi 同步」）。
# 若改用 docker-compose.usb.yml（bridge），那里已固定为 0。
IVAULT_WIFI=1

# USB 热插拔看护：1=启用（默认）。容器内的 usbmuxd 收不到 USB 插拔事件，
# 由看护检测到设备接入后重启 usbmuxd 重扫，插入后约 1 秒可用。
# 设为 0 则回到旧行为：容器运行中插 iPhone 不识别，需要重启容器。
#IVAULT_USB_WATCHDOG=0

# 日志：容器里三方输出都会进 docker logs，带前缀区分来源
#   [usbmuxd] 开头的详细日志（排查 USB 识别不到设备时设 1，平时不用）
#IVAULT_USBMUXD_VERBOSE=1
#   [netmuxd] 开头的日志级别：error / warn（默认）/ info / debug
#IVAULT_WIFI_LOG=warn
#   iVault 自身日志级别：DEBUG / INFO（默认）/ WARNING
#IVAULT_LOG=INFO

# 镜像来源：默认拉取 CI 预构建镜像，无需编译、无需访问 GitHub 源码
# latest = 跟随最新发布；也可固定成某个版本，例如 v0.3.0
IVAULT_TAG=latest
# 需要指向别的镜像仓库时，直接改 docker-compose.yml 里的 image 一行

# 需要本地编译时设 1，install.sh 会走 docker compose up --build
#IVAULT_BUILD=1
# 本地构建时 apt 源镜像（国内加速）
#APT_MIRROR=mirrors.ustc.edu.cn
