# 备份目录（宿主机绝对路径，需提前创建并有写权限）
# 路径按你自己的 NAS 卷结构填，不同平台不一样，常见写法：
#   群晖 / 绿联        /volume1/ivault/backups
#   威联通             /share/CACHEDEV1_DATA/ivault/backups
#   飞牛 / 普通 Linux  /vol1/ivault/backups、/mnt/disk1/ivault/backups
BACKUP_LOCATION=/volume1/ivault/backups
# 元数据目录：SQLite 数据库 + lockdown 配对证书（务必持久化）
META_LOCATION=/volume1/ivault/data
# Web 访问端口
IVAULT_PORT=8666

# 界面左下角显示的系统名，可留空（留空则尝试读取宿主机 os-release，取不到就隐藏）
# 例：DSM 7.2 / UGOS 1.21 / QTS 5.1 / TrueNAS SCALE 24.04 / fnOS 0.8
IVAULT_OS_NAME=

# 镜像来源：默认拉取 CI 预构建镜像，无需编译、无需访问 GitHub 源码
# latest = 跟随最新发布；也可固定成某个版本，例如 v0.2.0
IVAULT_TAG=latest
# 需要指向别的镜像仓库时，直接改 docker-compose.yml 里的 image 一行

# 需要本地编译时设 1，install.sh 会走 docker compose up --build
#IVAULT_BUILD=1
# 本地构建时 apt 源镜像（国内加速）
#APT_MIRROR=mirrors.ustc.edu.cn
